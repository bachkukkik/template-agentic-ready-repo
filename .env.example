# Project Environment Variables
# Copy to .env and fill in values before starting services.
#
#   cp .env.example .env
#
# Required vars will fail-fast at startup if unset.
# Optional vars use safe defaults.

# ─── Application ────────────────────────────────────────────────
APP_NAME=myproject
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=myproject
DB_PASSWORD=changeme
DB_NAME=myproject

# ─── Cache ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Secrets ────────────────────────────────────────────────────
JWT_SECRET=changeme-min-16-chars
SESSION_SECRET=changeme-min-16-chars

# ─── External Services ──────────────────────────────────────────
# Fill in before deploying to production
EXTERNAL_API_KEY=changeme

# ─── PR-Agent (optional) ────────────────────────────────────────
# Opt-in AI code review (Qodo PR-Agent). Dormant until enabled.
# CI reads its own GitHub values from Settings -> Secrets and variables
# -> Actions: variable PR_AGENT_ENABLED, variable OPENAI_BASE_URL,
# secret OPENAI_API_KEY, and optional variable OPENAI_DEFAULT_MODEL.
# The local values below only mirror those names for running the pr-agent
# CLI by hand — CI never reads this file; it reads the GitHub repository
# variables/secrets above. Placeholder values only — never a real value.
PR_AGENT_ENABLED=false
OPENAI_BASE_URL=
OPENAI_API_KEY=changeme
OPENAI_DEFAULT_MODEL=changeme
