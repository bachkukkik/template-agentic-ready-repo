# Secrets & credentials are local-only; only .example shapes are tracked
# (AGENTS.md §Security; ci.yml's secret-scan asserts it).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.credentials/*
!.credentials/*.example
!.credentials/*.example.*

node_modules/
dist/
build/
*.local

__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

docker-compose.override.yml

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

*.log
logs/

test-results/
coverage/
.coverage
htmlcov/

scratchpads/*
!scratchpads/.gitkeep

# Harness-local runtime state — the symlinks into .agents/ stay tracked.
.claude/*
!.claude/skills
!.claude/plugins
!.claude/agents

# The doctrine is TRACKED (AGENTS.md funnel rule 10): never ignore AGENTS.md,
# PRD.md, docs/, kb/, tests/, .agents/, .github/ — ci.yml's `doctrine` job
# fails the build if any of them is ignored.

.codegraph/
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_incremental.json
